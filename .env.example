ANAYASA_APP_NAME=Anayasa AI
ANAYASA_APP_VERSION=0.3.0
ANAYASA_ENV=development
ANAYASA_LOG_LEVEL=INFO

ANAYASA_EAGER_LOAD_RAG=false
ANAYASA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ANAYASA_CORS_ALLOW_CREDENTIALS=false

ANAYASA_RATE_LIMIT_ENABLED=true
ANAYASA_RATE_LIMIT_REQUESTS=20
ANAYASA_RATE_LIMIT_WINDOW_SECONDS=60

ANAYASA_QUERY_MIN_LENGTH=3
ANAYASA_QUERY_MAX_LENGTH=1500
ANAYASA_ANALYSIS_MIN_LENGTH=20
ANAYASA_ANALYSIS_MAX_LENGTH=5000

# Production ortamında doldurun.
ANAYASA_API_KEY=
ANAYASA_ENFORCE_HTTPS=false

# Docker icinden host makinedeki Ollama'ya erismek icin kullanilabilir.
OLLAMA_HOST=http://host.docker.internal:11434
